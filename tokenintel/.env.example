# TokenIntel ($TINTEL) — copy to .env and fill in values
# At least ONE LLM provider key is required (Swarms auto-detects via LiteLLM).

# --- LLM providers (set one or more) ---
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Default model for all agents (OpenAI, Anthropic, Groq, etc.)
TINTEL_LLM_MODEL=gpt-4o
# Alternative: claude-3-5-sonnet-20241022

# --- Web3 data providers ---
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# --- X (Twitter) API v2 (optional — App-only Bearer Token from developer.x.com) ---
# Keys & Tokens → App-Only Authentication → Generate (NOT Consumer Key / Secret)
X_BEARER_TOKEN=

# --- Application tuning ---
TINTEL_LOG_LEVEL=INFO
TINTEL_CACHE_DIR=.cache/tokenintel
TINTEL_CACHE_TTL_SECONDS=300
TINTEL_API_RATE_LIMIT_PER_MINUTE=30
TINTEL_MAX_RETRIES=3
TINTEL_REQUEST_TIMEOUT_SECONDS=30
